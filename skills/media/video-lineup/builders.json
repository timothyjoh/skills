      "port": 6670,
      "after": "control",
      "env": {
        "EARSHOT_HOME": "{{earshotHome}}"
      },
      "audit": [
        {
          "kind": "python",
          "cwd": ".",
          "extras": [
            "mcp"
          ]
        }
      ],
      "setup": [
        {
          "cwd": "vendor/earshot",
          "run": "uv venv --allow-existing --python 3.12 .venv"
        },
        {
          "cwd": "vendor/earshot",
          "run": "uv pip install --python .venv/bin/python torch --index-url https://download.pytorch.org/whl/cpu"
        },
        {
          "cwd": "vendor/earshot",
          "run": "uv pip install --python .venv/bin/python -e '.[mcp]'"
        },
        {
          "cwd": "vendor/earshot",
          "run": ".venv/bin/python -m earshot doctor --fetch"
        }

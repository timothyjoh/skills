{
  "name": "timothyjoh-skills",
  "version": "0.9.0",
  "private": true,
  "description": "Timothy Johnson's agent skills: turning channels, playlists and transcripts into knowledge an agent can work with",
  "repository": {
    "type": "git",
    "url": "https://github.com/timothyjoh/skills"
  },
  "license": "MIT",
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "check-plugin-version": "node scripts/sync-plugin-version.mjs --check",
    "validate": "claude plugin validate . --strict",
    "test:t3-handoff": "node --test skills/development/t3-handoff/scripts/tests/*.test.mjs",
    "test:explain-pr": "node --test skills/development/explain-pr/scripts/tests/*.test.mjs",
    "test:knowledge": "node --test scripts/tests/generated-skill-navigation.test.mjs skills/knowledge/playlist-to-skill/scripts/pts_pipeline.test.js"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0"
  },
  "packageManager": "npm@10.9.4"
}
